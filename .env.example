# LLM credentials — required ONLY for OFFLINE schema mining.
#
#   used by: codegist/validators/llm_val.py  (semantic validation)
#            codegist/auto_mining/llm_synth.py (Write-template synthesis)
#
# ONLINE compression (scripts/compress_auto.py + a shipped schema set) makes
# ZERO LLM calls and needs NONE of these. Copy this file to `.env` and fill in
# values only if you intend to mine your own schema set.
#
# The mining client speaks the OpenAI-compatible protocol (base_url / api_key /
# model). Never commit a real `.env` — it is git-ignored.

# Primary backbone (OpenAI-compatible endpoint).
LLM_MODEL_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional alternative backbones (only if you mine with them).
KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
GLM_API_KEY=
GLM_BASE_URL=
GLM_MODEL=
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=
